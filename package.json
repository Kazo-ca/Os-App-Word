{
  "name": "kazo-word-tests",
  "private": true,
  "description": "JavaScript tests of Kazo Word: the iframe proxy and the OS-side module (node), and end-to-end runs in the Kazo OS host (Playwright).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "store:readme": "node .github/scripts/store-readme.mjs",
    "test": "node --test tests/proxy/*.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.e2e.mjs",
    "test:installed": "node tests/installed/install-and-open.mjs"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
